# ───────────────────────────────────────────────────────────────────────────────────────────────
# ThoughtSpot Embed Playground — server configuration
#
# You DO NOT need this file for the basic flow. `npm start` works with browser-session auth and no
# config at all. Only set this up if you want Trusted Auth (minting tokens).
#
#   npm run setup     copies this file to .env (won't overwrite an existing one)
#   then fill in the two REQUIRED values below and run `npm start`.
#
# .env is gitignored — NEVER commit it.
# ───────────────────────────────────────────────────────────────────────────────────────────────

# ── REQUIRED for Trusted Auth ────────────────────────────────────────────────────────────────────

# Full URL of your ThoughtSpot instance.
THOUGHTSPOT_HOST=https://your-instance.thoughtspot.cloud

# Trusted-auth secret key. ThoughtSpot → Develop → Customizations → Security Settings →
# Trusted authentication. Stays server-side only and is NEVER sent to the browser.
TS_SECRET_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────────────────────────

# The user the server mints for when the UI leaves the username blank. SET THIS TO YOUR ThoughtSpot
# username (the placeholder 'tsadmin' only works if that user actually exists on your instance).
TS_DEFAULT_USERNAME=tsadmin

# Extra usernames the server may ALSO mint for (comma-separated). Leave BLANK to allow just the
# default user above — that's all most people need. Fail-closed: only listed users are permitted.
TS_USERNAME_ALLOWLIST=

# Default Org id (blank = the org tied to the secret key / primary org).
TS_DEFAULT_ORG_ID=

# Port for the server + static frontend.
PORT=3000

# ── Advanced dev guards (all fail-closed; relax only for a local playground) ──────────────────────

# Allow JIT provisioning (auto_create). When false, the server REFUSES auto_create so the browser
# can't provision a brand-new user and side-step TS_USERNAME_ALLOWLIST.
TS_ALLOW_JIT=false

# Groups the browser may request via group_identifiers. Comma-separated; fail-closed (empty = none).
# Use '*' to allow ANY group — needed to test arbitrary group-keyed RLS in the claims playground.
#   e.g.  TS_GROUP_ALLOWLIST=Sales,Marketing      or      TS_GROUP_ALLOWLIST=*
TS_GROUP_ALLOWLIST=

# Enable the /api/writeback stub sink (the write-back custom action demo).
TS_ALLOW_DEV_PROXY=false
